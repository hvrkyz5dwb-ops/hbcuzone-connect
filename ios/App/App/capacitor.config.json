{
	"appId": "app.lovable.plugu",
	"appName": "PlugU",
	"webDir": "native/www",
	"appendUserAgent": "PlugUApp",
	"server": {
		"url": "https://hbcuzone-connect.lovable.app",
		"cleartext": false,
		"androidScheme": "https",
		"errorPath": "index.html",
		"allowNavigation": [
			"hbcuzone-connect.lovable.app",
			"*.lovable.app",
			"*.supabase.co",
			"*.stripe.com",
			"checkout.stripe.com",
			"connect.stripe.com",
			"accounts.google.com",
			"fonts.googleapis.com",
			"fonts.gstatic.com"
		]
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#0a0a0a",
		"scrollEnabled": true,
		"limitsNavigationsToAppBoundDomains": false,
		"preferredContentMode": "mobile"
	},
	"android": {
		"backgroundColor": "#0a0a0a"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 350,
			"launchFadeOutDuration": 120,
			"backgroundColor": "#0a0a0a",
			"androidSplashResourceName": "splash",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0a0a0a",
			"overlaysWebView": true
		},
		"Keyboard": {
			"resize": "native",
			"style": "DARK",
			"resizeOnFullScreen": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
